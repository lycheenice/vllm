#!/usr/bin/env bash
# test4-mooncake-cpu-bypass —— TP4+TP4 PD 分离,MooncakeConnector + CPU 绕行。
# ★需要开发代码★:上游 MooncakeConnector 是 P2P GPU 直传,没有现成的 "CPU 中转" 开关。
# 需在本实验 code/ 下自定义(思路见 code/README.md),再通过 VLLM_CODE_OVERRIDE=1
# 把 code/vllm 覆盖进容器。开发未完成前,本实验不可跑(run.sh 会因缺 code/vllm 报错)。
EXP_NAME=test4-mooncake-cpu-bypass
MODE=pd
CONNECTOR=mooncake
BYPASS=cpu
TP=4
P_GPUS=0,1,2,3
D_GPUS=4,5,6,7
PORT_P=8130
PORT_D=8230
PROXY_PORT=8030
BOOTSTRAP_PORT=8999

# —— 代码覆盖(开发完成后置 1,并填容器内 vllm 包路径)——
# 用 docker exec <容器> python -c "import vllm,os;print(os.path.dirname(vllm.__file__))" 确认路径
VLLM_CODE_OVERRIDE=0
VLLM_PKG_PATH=/usr/local/lib/python3.12/dist-packages/vllm
export EXP_NAME MODE CONNECTOR BYPASS TP P_GPUS D_GPUS PORT_P PORT_D PROXY_PORT BOOTSTRAP_PORT
export VLLM_CODE_OVERRIDE VLLM_PKG_PATH
