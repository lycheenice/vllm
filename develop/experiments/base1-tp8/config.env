#!/usr/bin/env bash
# base1-tp8 —— 单实例 8 卡 TP8 基线(无 PD 分离)。这是所有 PD 方案的对照上界。
EXP_NAME=base1-tp8
MODE=single
CONNECTOR=none
BYPASS=none
TP=8
GPUS=0,1,2,3,4,5,6,7
PORT=8080
# MiniMax-M2.5 是 FP8 block 量化(block_n=128)。纯 TP8 会把每个 expert 的 gate/up
# 输出切成 192,192%128≠0 → create_weights 报 ValueError。整机跑大 MoE 的标准做法是
# 开专家并行 EP:experts 整块分到各 rank,不再 TP 切分 gate/up,规避该整除约束
# (attention 仍 TP8)。故 base1 实为 "TP8 attn + EP8 MoE" 的整机上界。
EXTRA_SERVE_ARGS="--enable-expert-parallel"
export EXP_NAME MODE CONNECTOR BYPASS TP GPUS PORT EXTRA_SERVE_ARGS
