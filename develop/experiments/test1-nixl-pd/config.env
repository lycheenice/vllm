#!/usr/bin/env bash
# test1-nixl-pd —— TP4+TP4 PD 分离,NixlConnector,KV 走 GPU 直传(NVLink/cuda_ipc)。
# 这是 PD 分离的主基线(对应既有 scripts/ 的 TRANSPORT=gdr)。
EXP_NAME=test1-nixl-pd
MODE=pd
CONNECTOR=nixl
BYPASS=none
TP=4
P_GPUS=0,1,2,3
D_GPUS=4,5,6,7
PORT_P=8100
PORT_D=8200
PROXY_PORT=8000
SIDE_PORT_P=5600
SIDE_PORT_D=5601
export EXP_NAME MODE CONNECTOR BYPASS TP P_GPUS D_GPUS PORT_P PORT_D PROXY_PORT SIDE_PORT_P SIDE_PORT_D
