#!/usr/bin/env bash
# test2-mooncake-pd —— TP4+TP4 PD 分离,MooncakeConnector(P2P),KV 直传。
# 与 test1 对比:同为 GPU 直传,只换 connector 实现(nixl vs mooncake)。
# ⚠ 依赖容器内有 `mooncake.engine`(python 库)。vllm-openai:v0.25.0 镜像默认不含,
#    首次运行前需在容器内 `pip install mooncake-transfer-engine` 并验证 import。
#    详见 README「前置依赖」。
EXP_NAME=test2-mooncake-pd
MODE=pd
CONNECTOR=mooncake
BYPASS=none
TP=4
P_GPUS=0,1,2,3
D_GPUS=4,5,6,7
PORT_P=8110
PORT_D=8210
PROXY_PORT=8010
BOOTSTRAP_PORT=8998
export EXP_NAME MODE CONNECTOR BYPASS TP P_GPUS D_GPUS PORT_P PORT_D PROXY_PORT BOOTSTRAP_PORT
