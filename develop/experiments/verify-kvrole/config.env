#!/usr/bin/env bash
# verify-kvrole —— 验证 kv_role 语义(kv_producer/consumer vs kv_both)是否影响 KV 真正传输。
# 独立端口,避免与 test1 冲突。KV_ROLE_MODE 由 verify.sh / 命令行覆盖(pc | both)。
EXP_NAME=verify-kvrole
MODE=pd
CONNECTOR=nixl
BYPASS=none
TP=4
P_GPUS=0,1,2,3
D_GPUS=4,5,6,7
PORT_P=8140
PORT_D=8240
PROXY_PORT=8040
SIDE_PORT_P=5620
SIDE_PORT_D=5621
KV_ROLE_MODE="${KV_ROLE_MODE:-pc}"     # pc=kv_producer/kv_consumer(默认) | both=kv_both
export EXP_NAME MODE CONNECTOR BYPASS TP P_GPUS D_GPUS PORT_P PORT_D PROXY_PORT SIDE_PORT_P SIDE_PORT_D KV_ROLE_MODE
