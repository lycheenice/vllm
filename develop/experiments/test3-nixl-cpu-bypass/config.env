#!/usr/bin/env bash
# test3-nixl-cpu-bypass —— TP4+TP4 PD 分离,NixlConnector + CPU 绕行。
# KV 缓冲设备 = cpu(kv_buffer_device="cpu"):KV 先 D2H 落宿主内存,经 NIXL 传输,
# 再 H2D 到对端。★用既有代码即可实现★(env 的 BYPASS=cpu -> kv_buffer_device=cpu,
# 对应既有 scripts/ 的 TRANSPORT=cpu),无需改 vLLM 源码。
# 对比 test1:量化 "GPU 直传 vs CPU 中转" 的传输开销差异。
EXP_NAME=test3-nixl-cpu-bypass
MODE=pd
CONNECTOR=nixl
BYPASS=cpu
TP=4
P_GPUS=0,1,2,3
D_GPUS=4,5,6,7
PORT_P=8120
PORT_D=8220
PROXY_PORT=8020
SIDE_PORT_P=5610
SIDE_PORT_D=5611
export EXP_NAME MODE CONNECTOR BYPASS TP P_GPUS D_GPUS PORT_P PORT_D PROXY_PORT SIDE_PORT_P SIDE_PORT_D
