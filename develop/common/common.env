#!/usr/bin/env bash
# develop/common/common.env
# 所有实验共享的默认值。被各实验 experiments/<exp>/config.env 先 source,
# 再由 config.env 覆盖差异项。不要在这里放某个实验特有的配置。
#
# 约定:变量都用 ${X:-default} 形式,允许命令行 env 覆盖。

set -u

# ---------------------------------------------------------------------------
# 路径 / 仓库
# ---------------------------------------------------------------------------
# common/ 的上级是 develop/,再上级是 vllm 仓库根。
COMMON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DEV_ROOT="$(cd "$COMMON_DIR/.." && pwd -P)"
REPO_ROOT="$(cd "$DEV_ROOT/.." && pwd -P)"     # /ceph/User/E01223/mycode/vllm(a100-2 权威;h200-2 经 /ceph 可见)
export COMMON_DIR DEV_ROOT REPO_ROOT

# ---------------------------------------------------------------------------
# 执行端(h200-2)—— 服务都在这台机的 docker 里跑
# ---------------------------------------------------------------------------
EXEC_HOST="${EXEC_HOST:-h200-2}"               # ssh 别名(用 ssh -l root)
EXEC_SSH="${EXEC_SSH:-ssh -l root $EXEC_HOST}"
EXEC_IP="${EXEC_IP:-10.119.195.74}"           # h200-2 bond1(发压端 h200-6 从这个 IP 打;实测通 HTTP 200)
# h200-2 挂载了 /ceph,容器直接 bind-mount 仓库,免二次同步。
REPO_ON_EXEC="${REPO_ON_EXEC:-/ceph/User/E01223/mycode/vllm}"

# vLLM v0.25.0 官方镜像(已含 nixl;mooncake.engine 需另装,见 test2/test4)
IMAGE="${IMAGE:-docker.1ms.run/vllm/vllm-openai:v0.25.0}"
MODEL_PATH="${MODEL_PATH:-/data1/models/MiniMax-M2.5}"
MODEL_DIR_HOST="${MODEL_DIR_HOST:-/data1/models}"

# ---------------------------------------------------------------------------
# vLLM serve 公共参数
# ---------------------------------------------------------------------------
MAX_MODEL_LEN="${MAX_MODEL_LEN:-65536}"        # 32768 下 codex 多轮累积超长,~15% 请求 HTTP400;
                                               # 模型支持 196608,提到 65536(对齐 glm52-test)消除截断错误
UTIL="${UTIL:-0.90}"
BLOCK_SIZE="${BLOCK_SIZE:-128}"
ENFORCE_EAGER="${ENFORCE_EAGER:-1}"            # 1 => --enforce-eager(首轮快速验证,减少 cudagraph 编译等待)
ENABLE_PREFIX_CACHING="${ENABLE_PREFIX_CACHING:-1}"
HEALTH_TIMEOUT="${HEALTH_TIMEOUT:-1200}"       # 秒;MiniMax-M2.5 230GB 载入慢

# P2pNccl/Nixl 集群既有踩坑(见 memory feedback_p2p_nccl_startup):
# 单机 Nixl 不一定全需要,但 REQUEST_ID 随机化关闭是安全默认。
COMMON_DOCKER_ENV=(
  -e VLLM_DISABLE_REQUEST_ID_RANDOMIZATION=1
  -e HF_HOME=/tmp/hf_home
  -e TRITON_CACHE_DIR=/tmp/triton_cache
  -e TORCH_HOME=/tmp/torch_home
  -e VLLM_LOGGING_LEVEL=INFO
)

# ---------------------------------------------------------------------------
# 发压端(kvcache-benchmarks,只在 h200-6)—— 统一 bench 口径
# ---------------------------------------------------------------------------
BENCH_HOST="${BENCH_HOST:-h200-6}"
BENCH_SSH="${BENCH_SSH:-ssh -l root $BENCH_HOST}"
KVBENCH_DIR="${KVBENCH_DIR:-/home/lychee/mycode/kvcache-benchmarks}"
DATASET="${DATASET:-$KVBENCH_DIR/data/codex_swebenchpro_traces/codex_swebenchpro.json}"

# h200-6 系统 python3 缺 numpy/aiohttp/tqdm 且无 pip/ensurepip;发压改走 CPU-only docker
# 容器(复用 vllm 镜像现成依赖,不加 --gpus 故不碰生产 GPU,也不污染宿主)。挂载点=宿主
# 真实路径,保证 dataset / output-dir 在容器内外路径一致,tar 回拉不受影响。
KVBENCH_PY="${KVBENCH_PY:-docker run --rm --network host -v $KVBENCH_DIR:$KVBENCH_DIR -w $KVBENCH_DIR --entrypoint python3 $IMAGE}"

# ★ 统一 sweep 口径(用户指定):并发 1/4/8/16,turns=4,每组尽量 <10min。
LEVELS="${LEVELS:-1,4,8,16}"
MAX_TURNS="${MAX_TURNS:-4}"
TRIALS_PER_USER="${TRIALS_PER_USER:-4}"        # 总 trials = level*这个;控制单组时长的主旋钮
MAX_TOKENS="${MAX_TOKENS:-256}"               # 输出上限,截断保证时长可控
SHUFFLE_SEED="${SHUFFLE_SEED:-42}"

export EXEC_HOST EXEC_SSH EXEC_IP REPO_ON_EXEC IMAGE MODEL_PATH MODEL_DIR_HOST
export MAX_MODEL_LEN UTIL BLOCK_SIZE ENFORCE_EAGER ENABLE_PREFIX_CACHING HEALTH_TIMEOUT
export BENCH_HOST BENCH_SSH KVBENCH_DIR DATASET LEVELS MAX_TURNS TRIALS_PER_USER MAX_TOKENS SHUFFLE_SEED
export KVBENCH_PY
